# Copiar este archivo como back/.env y completar los valores.
# El .env real NO se sube a Git. Cada máquina tiene el suyo: en desarrollo solo valores de prueba.

# MongoDB (scripts/conf/engine.py)
MONGO_URI=mongodb://USUARIO:CLAVE@IP:PUERTO/?authSource=NOMBRE_BASE
MONGO_DB=NOMBRE_BASE

# Servidor SFTP: descarga de padrones y envío de los TXT del cierre (utils/padrones/descargarPadrones.py)
SFTP_HOST=
SFTP_LOGIN=
SFTP_PASSWORD=
# Carpeta remota de los padrones; se descargan de SFTP_DIR_REMOTO/PERIODO/B
SFTP_DIR_REMOTO=/datos
